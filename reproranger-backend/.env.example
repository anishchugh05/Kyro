# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=90

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GOOGLE_API_KEY=your_google_key_here
GOOGLE_MODEL=gemini-1.5-flash

# ── GitHub (required for PR creation) ─────────────────────────────────────────
# Generate at https://github.com/settings/tokens/new — tick only: repo
GITHUB_TOKEN=your_github_pat_here

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL of the workspace app (used by the homepage Initialize button)
WORKSPACE_URL=http://localhost:5174

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ── Limits ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
PORT=8000
